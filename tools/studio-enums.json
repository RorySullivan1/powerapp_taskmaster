  "child_properties_confirmed": [
   "LayoutMinWidth",
   "LayoutMinHeight"
  ],
  "inferred_not_confirmed": [
   "LayoutOverflowY / LayoutOverflowX  \u2014 the scroll switch. Display names are",
   "'Vertical Overflow' / 'Horizontal Overflow'; the Layout* prefix is confirmed",
   "for Direction, AlignItems, MinWidth and MinHeight, so this follows the same",
   "convention \u2014 but it is an INFERENCE and it is the property the whole",
   "scrollable-form design depends on. Confirm before authoring a screen with it.",
   "LayoutGap, LayoutJustifyContent, LayoutWrap, FillPortions \u2014 same status."
  ]
 }
